{
	"name": "esphome-api",
	"version": "3.1.0",
	"description": "ESPHome client module for Companion",
	"type": "module",
	"homepage": "https://github.com/bitfocus/companion-module-esphome-api#readme",
	"main": "dist/index.js",
	"scripts": {
		"format": "prettier -w .",
		"postinstall": "husky",
		"package": "run build && companion-module-build",
		"build": "rimraf dist && node scripts/generate-icons.mjs && run build:main",
		"build:main": "tsc -p tsconfig.build.json",
		"build:watch": "tsc -p tsconfig.build.json --watch",
		"lint:raw": "eslint",
		"lint:md": "markdownlint-cli2 '**/*.md' '!node_modules' '!dist' '!pkg'",
		"lint": "run lint:raw . && run lint:md"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bitfocus/companion-module-esphome-api.git"
	},
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/bitfocus/companion-module-esphome-api/issues"
	},
	"lint-staged": {
		"*.md": [
			"prettier --write",
			"markdownlint-cli2"
		],
		"*.{css,json,scss}": [
			"prettier --write"
		],
		"*.{ts,tsx,js,jsx}": [
			"yarn lint:raw --fix"
		]
	},
	"engines": {
		"node": "^26.5",
		"yarn": "^4"
	},
	"dependencies": {
		"@companion-module/base": "~2.1.3",
		"esphome-client": "^2"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.2.0",
		"@iconify-json/mdi": "^1.2.3",
		"@iconify/utils": "^3.1.7",
		"@resvg/resvg-wasm": "^2.6.2",
		"@types/node": "^22.20.5",
		"eslint": "^10.12.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"markdownlint-cli2": "^0.24.2",
		"prettier": "^3.9.9",
		"rimraf": "^6.1.3",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.71.0"
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"packageManager": "yarn@4.18.1"
}
